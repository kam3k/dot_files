#!/usr/bin/env bash
set -euo pipefail

selection="$(
printf "1 - Lock\n2 - Suspend\n3 - Log out\n4 - Reboot\n5 - Shutdown\n" |
fuzzel --dmenu -l 5 -p "Power: "
)"

case "$selection" in
*"Lock")
swaylock -f -c 0e1018
;;
*"Suspend")
swaylock -f -c 0e1018
systemctl suspend
;;
*"Log out")
swaymsg exit
;;
*"Reboot")
systemctl reboot
;;
*"Shutdown")
systemctl poweroff
;;
esac
