### ===============================================================================================
### BASIC SETUP
### ===============================================================================================

set $mod Mod4
font pango:Iosevka Term 12

set $XDG_CURRENT_DESKTOP sway
set $XDG_SESSION_TYPE wayland
set $XDG_SESSION_DESKTOP sway

### ===============================================================================================
### WALLPAPER
### ===============================================================================================

exec_always sh -c '[ -f ~/.config/wallpapers/default.jpg ] && swaybg -i ~/.config/wallpapers/default.jpg -m fill'

### ===============================================================================================
### INPUT
### ===============================================================================================

# keyboard layout
input * {
    xkb_layout us
    repeat_delay 300
    repeat_rate 40
}

# swipe between workspaces
bindgesture swipe:3:left workspace prev
bindgesture swipe:3:right workspace next

# hide cursor after three seconds
seat seat0 hide_cursor 3000

### ===============================================================================================
### DESKTOP AUTOSTART SERVICES
### ===============================================================================================

# core desktop services (wayland session)
exec_always dbus-update-activation-environment --systemd WAYLAND_DISPLAY XDG_CURRENT_DESKTOP=sway

# usb automount
exec udiskie -a

# network
exec nm-applet --indicator

# notifications
exec mako

# lock (automatic, also turn screen off after a while)
exec swayidle -w \
  timeout 600 'exec gtklock -b 0e1018' \
  timeout 1200 'swaymsg "output * dpms off"' \
  resume 'swaymsg "output * dpms on"' \
  before-sleep 'exec gtklock -b 0e1018'

# waybar
exec_always sh -c 'pkill -x waybar || true; sleep 0.2; waybar'

### ===============================================================================================
### MONITORS
### ===============================================================================================

set $laptop eDP-1
bindswitch --reload --locked lid:on output $laptop disable
bindswitch --reload --locked lid:off output $laptop enable
exec_always ~/.local/bin/laptop-lid-state

output HDMI-A-1 scale 1.5

### ===============================================================================================
### BASIC KEYBINDINGS
### ===============================================================================================

# terminal
bindsym $mod+Return exec foot

# launcher
bindsym $mod+space exec fuzzel-actions

# power menu
bindsym $mod+x exec fuzzel-pwrmenu

# kill window
bindsym $mod+q kill

# focus movement (vim-style)
bindsym $mod+h focus left
bindsym $mod+j focus down
bindsym $mod+k focus up
bindsym $mod+l focus right

# move window
bindsym $mod+Shift+h move left
bindsym $mod+Shift+j move down
bindsym $mod+Shift+k move up
bindsym $mod+Shift+l move right

# back and forth workspaces
bindsym $mod+Tab workspace back_and_forth

# fullscreen
bindsym $mod+f fullscreen toggle

# floating toggle
bindsym $mod+Shift+f floating toggle

# open next split vertical or horizontal
bindsym $mod+backslash splith
bindsym $mod+minus splitv

# reload sway
bindsym $mod+Shift+c reload

# lock screen
bindsym $mod+Shift+x exec gtklock -b 0e1018

# resize containers
mode "resize" {
    bindsym h resize grow width 10px
    bindsym j resize shrink height 10px
    bindsym k resize grow height 10px
    bindsym l resize shrink width 10px
    bindsym Return mode "default"
    bindsym Escape mode "default"
}
bindsym $mod+r mode "resize"

### ===============================================================================================
### MOUSE/TRACKPAD
### ===============================================================================================

input type:touchpad {
    natural_scroll enabled
    tap enabled
    dwt enabled
}

focus_follows_mouse no

### ===============================================================================================
### WORKSPACES (your original style preserved)
### ===============================================================================================

set $ws1 "1"
set $ws2 "2"
set $ws3 "3"
set $ws4 "4"
set $ws5 "5"
set $ws6 "6"
set $ws7 "7"
set $ws8 "8"
set $ws9 "9"
set $ws10 "10"

bindsym $mod+1 workspace $ws1
bindsym $mod+2 workspace $ws2
bindsym $mod+3 workspace $ws3
bindsym $mod+4 workspace $ws4
bindsym $mod+5 workspace $ws5
bindsym $mod+6 workspace $ws6
bindsym $mod+7 workspace $ws7
bindsym $mod+8 workspace $ws8
bindsym $mod+9 workspace $ws9
bindsym $mod+0 workspace $ws10

bindsym $mod+Shift+1 move container to workspace $ws1, workspace $ws1
bindsym $mod+Shift+2 move container to workspace $ws2, workspace $ws2
bindsym $mod+Shift+3 move container to workspace $ws3, workspace $ws3
bindsym $mod+Shift+4 move container to workspace $ws4, workspace $ws4
bindsym $mod+Shift+5 move container to workspace $ws5, workspace $ws5
bindsym $mod+Shift+6 move container to workspace $ws6, workspace $ws6
bindsym $mod+Shift+7 move container to workspace $ws7, workspace $ws7
bindsym $mod+Shift+8 move container to workspace $ws8, workspace $ws8
bindsym $mod+Shift+9 move container to workspace $ws9; workspace $ws9
bindsym $mod+Shift+0 move container to workspace $ws10, workspace $ws10

# back and forth
bindsym $mod+p workspace back_and_forth

### ===============================================================================================
### WINDOWS
### ===============================================================================================

default_border pixel 1
default_floating_border pixel 1
smart_borders on

client.focused          #80c8e0 #0e1018 #c8d0e0 #80c8e0 #80c8e0
client.unfocused        #0e1018 #0e1018 #9aa4b8 #364050 #0e1018

# assign some applications to specific workspaces
assign [app_id="^firefox-esr$"] 1
assign [app_id="Slack$"] 3

# start up specific applications (done this way to make sure environment is ready)
exec firefox-esr
exec workspace 2
exec foot
exec sh -c 'flatpak info com.slack.Slack >/dev/null 2>&1 && flatpak run com.slack.Slack'
exec swaymsg workspace 1

# floating windows
for_window [app_id="btop"] floating enable, resize set 1400 900, move position center, border pixel 1
for_window [app_id="ncdu"] floating enable, resize set 1400 900, move position center, border pixel 1
for_window [app_id="pavucontrol"] floating enable, move position center, border pixel 1
for_window [app_id="blueman-manager"] floating enable, move position center, border pixel 1
for_window [app_id="gsimplecal"] floating enable, move position center, border pixel 1

### ===============================================================================================
### LAYOUT CONTROL
### ===============================================================================================

bindsym $mod+w layout tabbed
bindsym $mod+e layout toggle split

### ===============================================================================================
### SCRATCHPADS
### ===============================================================================================

# terminal
for_window [app_id="term_scratch"] {
    floating enable
    move position center
    move to scratchpad
    border pixel 1
}
bindsym $mod+Shift+grave exec foot --app-id=term_scratch
bindsym $mod+grave [app_id="term_scratch"] scratchpad show, resize set 1400 900, border pixel 1

# todo list
for_window [app_id="todo_scratch"] {
    floating enable
    move position center
    move to scratchpad
    border pixel 1
}
bindsym $mod+Shift+t exec foot --app-id=todo_scratch nvim ~/.todo.txt
bindsym $mod+t [app_id="todo_scratch"] scratchpad show, resize set 1400 900, move position center

# notes
for_window [app_id="notes_scratch"] {
    floating enable
    move position center
    move to scratchpad
    border pixel 1
}
bindsym $mod+Shift+n exec foot --app-id=notes_scratch --working-directory ~/.notes nvim -c Explore
bindsym $mod+n [app_id="notes_scratch"] scratchpad show, resize set 1400 900, move position center

# music
for_window [app_id="plexamp"] {
    floating enable
    move position center
    move to scratchpad
}
bindsym $mod+Shift+m exec sh -c 'flatpak info com.plexamp.Plexamp >/dev/null 2>&1 && flatpak run com.plexamp.Plexamp'
bindsym $mod+m [app_id="plexamp"] scratchpad show, resize set 500 800, move position center

### ===============================================================================================
### SCREENSHOT
### ===============================================================================================

bindsym $mod+Shift+minus exec screenshot
bindsym $mod+Shift+equal exec screenshot-region
bindsym $mod+Shift+bracketleft exec screenrecord
bindsym $mod+Shift+bracketright exec pkill -INT wf-recorder

### ===============================================================================================
### AUDIO
### ===============================================================================================

bindsym XF86AudioRaiseVolume exec wpctl set-volume @DEFAULT_AUDIO_SINK@ 5%+
bindsym XF86AudioLowerVolume exec wpctl set-volume @DEFAULT_AUDIO_SINK@ 5%-
bindsym XF86AudioMute exec wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle
