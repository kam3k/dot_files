{
  "layer": "top",
  "position": "top",
  "height": 34,

  "modules-left": ["sway/workspaces"],
  "modules-center": ["clock"],
  "modules-right": [
    "custom/recording",
    "custom/media",
    "pulseaudio",
    "cpu",
    "memory",
    "disk",
    "battery"
  ],

  "sway/workspaces": {
    "disable-scroll": true,
    "all-outputs": true,
    "format": "{name}"
  },

  "clock": {
    "format": "{:%H:%M}",
    "tooltip-format": "{:%A, %B %d, %Y}",
    "on-click": "gsimplecal"
  },

  "custom/recording": {
    "exec": "~/.local/bin/rec-status",
    "interval": 1,
    "format": "{}",
    "on-click": "pkill -INT wf-recorder"
  },

  "cpu": {
    "format": "󰻠  {usage}%",
    "interval": 2,
    "tooltip": true,
    "on-click": "foot --app-id=btop btop",
    "states": {
      "warning": 70,
      "critical": 90
    }
  },

  "memory": {
    "format": "󰍛  {percentage}%",
    "interval": 2,
    "tooltip": true,
    "on-click": "foot --app-id=btop btop",
    "states": {
      "warning": 70,
      "critical": 90
    }
  },

  "pulseaudio": {
    "format": "   {volume}%",
    "format-muted": "  muted",
    "on-click": "pavucontrol",
    "scroll-step": 5
  },

  "disk": {
    "interval": 30,
    "format": "󰋊  {percentage_used}%",
    "path": "/",
    "tooltip-format": "Root: {used} used of {total} ({percentage_used}%)",
    "on-click": "foot --app-id=ncdu ncdu ~",
    "states": {
        "warning": 80,
        "critical": 90
    }
  },

  "battery": {
    "format": "   {capacity}%",
    "format-charging": "  {capacity}%",
    "states": {
      "warning": 30,
      "critical": 15
    }
  },

  "custom/media": {
    "exec": "~/.local/bin/media-status",
    "interval": 2,
    "max-length": 40,
    "on-click": "playerctl play-pause"
  }
}
